                  "$ref": "#/components/schemas/DashScopeErrorResponse"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "label": "cURL (Wan 2.6)",
            "source": "curl --location 'https://dashscope.aliyuncs.com/api/v1/services/aigc/image-generation/generation' \\\n--header 'Content-Type: application/json' \\\n--header \"Authorization: Bearer $DASHSCOPE_API_KEY\" \\\n--header 'X-DashScope-Async: enable' \\\n--data '{\n  \"model\": \"wan2.6-t2i\",\n  \"input\": {\n    \"messages\": [\n      {\n        \"role\": \"user\",\n        \"content\": [\n          {\n            \"text\": \"A flower shop with elegant windows, a beautiful wooden door, filled with flowers\"\n          }\n        ]\n      }\n    ]\n  },\n  \"parameters\": {\n    \"prompt_extend\": true,\n    \"watermark\": false,\n    \"n\": 1,\n    \"size\": \"1280*1280\"\n  }\n}'"
          }
        ]
      }
    },
    "/services/aigc/image2image/image-synthesis": {
      "post": {
        "operationId": "createImageSpecialized",
        "summary": "创建专项图像",
        "description": "以异步方式执行专项图像任务。通过 `model` 参数指定具体操作类型，接口立即返回 `task_id`，后续通过轮询任务状态接口获取结果。\n\n支持的功能：人像风格重绘、背景生成、图像扩展、创意海报、图像修复、人像分割、线稿生图、虚拟试穿、虚拟模特、鞋品模特。\n\n## 可用模型\n\n| 模型 | 说明 |\n|-------|-------------|\n| wanx-style-repaint-v1 | 在保留人物身份的前提下，将人像以指定艺术风格重新绘制。 |\n| wanx-background-generation-v2 | 为产品或主体图像生成或替换背景。 |\n| image-expansion | 扩展图像画布，用 AI 生成内容填充新增区域。 |\n| wanx-poster-generation-v1 | 根据产品图像、文案和版式要求生成宣传海报。 |\n| image-inpainting | 擦除图像中选定区域并用符合上下文的内容填充。 |\n| person-segmentation | 从图像中分割出单个人物。 |\n| wanx-sketch-to-image-v1 | 将草图或手绘稿转换为精细图像。 |\n| aitryon-v1 | 基础版虚拟试穿，输入人物图和服装图进行合成。 |\n| aitryon-v2 | 增强版虚拟试穿，试穿效果更逼真。 |\n| virtual-model | 生成穿着指定服装的虚拟模特图像。 |\n| shoe-model | 在虚拟模特或背景上生成鞋品商品图。 |\n| facechain-generation | 通过少量自拍照训练后生成 AI 人像写真。 |\n\n## 注意事项\n\n- 请求时必须携带 `X-DashScope-Async: enable` 请求头。\n- 提交后，使用 `GET /tasks/{task_id}` 轮询结果。\n- 任务结果 **24 小时**后失效，请及时下载输出图像。\n- 请求体结构因模型而异，详见下方各模型参数说明。\n\n## 虚拟试穿参数\n\n| 参数 | 类型 | 必填 | 说明 |\n|-----------|------|----------|-------------|\n| model | string | 是 | `aitryon-v1`（基础版）或 `aitryon-v2`（增强版）。 |\n| input.person_image_url | string | 是 | 人物图像 URL。 |\n| input.garment_image_url | string | 是 | 服装图像 URL。 |\n| parameters.resolution | integer | 否 | 输出分辨率（短边像素数），默认值：768。 |\n\n## 背景生成参数\n\n| 参数 | 类型 | 必填 | 说明 |\n|-----------|------|----------|-------------|\n| model | string | 是 | `wanx-background-generation-v2`。 |\n| input.base_image_url | string | 是 | 前景/产品图像 URL。 |\n| input.prompt | string | 否 | 期望背景的描述文字。 |\n| parameters.n | integer | 否 | 生成图像数量（1-4），默认值：1。 |",
        "parameters": [
          {
            "name": "X-DashScope-Async",
            "in": "header",
            "required": true,
            "description": "异步任务提交时必须设置为 `enable`。",
            "schema": {
              "type": "string",
              "enum": [
                "enable"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecializedImageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncTaskSubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashScopeErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "认证失败——API Key 无效或未提供",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashScopeErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求频率超出限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashScopeErrorResponse"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "label": "cURL (Virtual Try-On)",
            "source": "curl -X POST 'https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis' \\\n--header 'X-DashScope-Async: enable' \\\n--header \"Authorization: Bearer $DASHSCOPE_API_KEY\" \\\n--header 'Content-Type: application/json' \\\n--data '{\n  \"model\": \"aitryon-v2\",\n  \"input\": {\n    \"person_image_url\": \"https://example.com/person.jpg\",\n    \"garment_image_url\": \"https://example.com/garment.jpg\"\n  },\n  \"parameters\": {\n    \"resolution\": 768\n  }\n}'"
          },
          {
            "lang": "curl",
            "label": "cURL (Background Generation)",
            "source": "curl -X POST 'https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis' \\\n--header 'X-DashScope-Async: enable' \\\n--header \"Authorization: Bearer $DASHSCOPE_API_KEY\" \\\n--header 'Content-Type: application/json' \\\n--data '{\n  \"model\": \"wanx-background-generation-v2\",\n  \"input\": {\n    \"base_image_url\": \"https://example.com/product.jpg\",\n    \"prompt\": \"On a marble countertop in a modern kitchen, warm lighting\"\n  },\n  \"parameters\": {\n    \"n\": 1\n  }\n}'"
          }
        ]
      }
    },
